# PostgreSQL (docker compose up -d db starts one on port 5434)
DATABASE_URL=postgresql://kingsss:kingsss_dev_password@localhost:5434/kingsss
PORT=4000
# First admin account, created by `npm run db:seed` when no users exist
ADMIN_EMAIL=info@kingsssimportexportllp.com
ADMIN_PASSWORD=change-this-password
# Optional: extra allowed origins for API writes, comma-separated
ALLOWED_ORIGINS=
# Media storage: set to upload images/videos to Cloudinary (Dashboard → API Keys → "API environment variable").
# Leave empty to store uploads on the server disk (server/uploads).
CLOUDINARY_URL=
CLOUDINARY_FOLDER=kingsss

# Email — enquiry notifications (GoDaddy). Pick the block matching your GoDaddy email product:
#   Professional Email (Titan) ....... SMTP_HOST=smtp.titan.email        SMTP_PORT=465
#   Workspace / older GoDaddy email .. SMTP_HOST=smtpout.secureserver.net SMTP_PORT=465
#   Microsoft 365 from GoDaddy ....... SMTP_HOST=smtp.office365.com       SMTP_PORT=587  (SMTP AUTH must be enabled for the mailbox)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@kingsssimportexportllp.com
SMTP_PASS=
MAIL_FROM="KINGSSS Import Export <info@kingsssimportexportllp.com>"
# Who receives new-enquiry emails (comma-separated). Defaults to SMTP_USER.
ENQUIRY_NOTIFY_TO=info@kingsssimportexportllp.com
# Also send the customer a "we received your enquiry" email
ENQUIRY_AUTOREPLY=true
# Public website address, used for links/buttons in emails
PUBLIC_SITE_URL=https://kingsssimportexportllp.com
