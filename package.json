{
  "name": "kingsss-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "dev:server": "node --watch --env-file=.env server/src/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node --env-file=.env server/src/index.js",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate deploy --config server/prisma.config.mjs",
    "db:migrate:dev": "prisma migrate dev --config server/prisma.config.mjs && prisma generate --config server/prisma.config.mjs",
    "db:generate": "prisma generate --config server/prisma.config.mjs",
    "db:seed": "node --env-file=.env server/seed/seed.js",
    "db:studio": "prisma studio --config server/prisma.config.mjs",
    "postinstall": "prisma generate --config server/prisma.config.mjs",
    "email:signatures": "node --env-file=.env server/scripts/email-signatures.js",
    "logos:upload": "node --env-file=.env server/scripts/upload-logos.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/query-sync-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "cloudinary": "^2.11.0",
    "express": "^5.3.0",
    "motion": "^14.1.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "prisma": "^7.10.0",
    "vite": "^8.3.4"
  }
}
